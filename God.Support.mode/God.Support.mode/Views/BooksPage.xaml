<UserControl x:Class="God.Support.mode.Views.BooksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:God.Support.mode.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsAddDialogOpen}" CloseOnClickAway="False">
        <materialDesign:DialogHost.DialogContent>
            <StackPanel Width="420" Margin="24">
                <TextBlock Text="Uj konyv" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16"/>
                <TextBox Text="{Binding NewBookCim}" materialDesign:HintAssist.Hint="Cim"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding NewBookAuthorId}" materialDesign:HintAssist.Hint="Szerzo azonosito"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding NewBookKategoria}" materialDesign:HintAssist.Hint="Kategoria"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding NewBookAr}" materialDesign:HintAssist.Hint="Ar"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding NewBookBoritokep}" materialDesign:HintAssist.Hint="Boritokep URL"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding NewBookTartalom}" materialDesign:HintAssist.Hint="Tartalom / Leiras"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"
                         AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Megse" Command="{Binding CloseAddDialogCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,12,0"/>
                    <Button Content="Letrehozas" Command="{Binding ConfirmAddBookCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <!-- Header -->
                <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                    <TextBlock Text="Konyvek" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Uj konyv" Command="{Binding OpenAddDialogCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,12,0"/>
                        <Button Content="{materialDesign:PackIcon Kind=Refresh}"
                                Command="{Binding LoadDataCommand}"
                                Style="{StaticResource MaterialDesignIconButton}" ToolTip="Frissites"/>
                    </StackPanel>
                </DockPanel>

                <!-- Filter Bar -->
                <materialDesign:Card DockPanel.Dock="Top" Margin="24,12,24,0" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Kereses cim vagy szerzo szerint..."
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="300" Margin="4"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  materialDesign:HintAssist.Hint="Kategoria"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="200" Margin="12,4,4,4"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- DataGrid -->
                <DataGrid Margin="24,12,24,24"
                          ItemsSource="{Binding Books}"
                          SelectedItem="{Binding SelectedBook}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserSortColumns="True"
                          AlternationCount="0"
                          materialDesign:DataGridAssist.CellPadding="12 8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Azon." Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Cim" Binding="{Binding Cim}" Width="*"/>
                        <DataGridTextColumn Header="Szerzo" Binding="{Binding AuthorNev}" Width="*"/>
                        <DataGridTextColumn Header="Kategoria" Binding="{Binding Kategoria}" Width="120"/>
                        <DataGridTextColumn Header="Ar" Binding="{Binding Ar, StringFormat=N0}" Width="90"/>
                        <DataGridTextColumn Header="Elerheto" Binding="{Binding Elerheto}" Width="80"/>
                        <DataGridTextColumn Header="Boritokep URL" Binding="{Binding Boritokep}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Detail Flyout Panel -->
            <Border Grid.Column="1" Width="380" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,12">
                        <TextBlock Text="Konyv reszletei" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   VerticalAlignment="Center"/>
                        <Button Content="{materialDesign:PackIcon Kind=Close}"
                                Command="{Binding CloseDetailCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
                        <StackPanel>
                            <TextBox Text="{Binding SelectedBook.Cim, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Cim"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding SelectedBook.AuthorId, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Szerzo azonosito"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding SelectedBook.Kategoria, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Kategoria"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding SelectedBook.Ar, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Ar"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding SelectedBook.Boritokep, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Boritokep URL"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding SelectedBook.Tartalom, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Tartalom / Leiras"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"
                                     AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>

                            <Button Content="Modositasok mentese" Command="{Binding SaveBookCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                            <Separator Margin="0,0,0,16"/>

                            <!-- Copies -->
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Peldanyok" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="Peldany hozzaadasa" Command="{Binding AddCopyCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Right" Padding="8,4"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding BookCopies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                            <DockPanel>
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="Peldany #"/><Run Text="{Binding Id, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Opacity="0.6" Margin="0,4,0,0">
                                                         <Run Text="Elerheto:"/>
                                                         <Run Text="{Binding Elerheto, Mode=OneWay}"/>
                                                     </TextBlock>
                                                </StackPanel>
                                                <Button Content="{materialDesign:PackIcon Kind=Delete}"
                                                        Command="{Binding DataContext.DeleteCopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                        Foreground="#F44336" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,16"/>

                            <Button Content="Konyv torlese" Command="{Binding DeleteBookCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="#F44336" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Loading Overlay -->
            <Grid Grid.ColumnSpan="2" Background="#80000000"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                  IsHitTestVisible="False">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="48" Height="48"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>

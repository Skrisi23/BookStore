<Window x:Class="God.Support.mode.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:God.Support.mode.Converters"
        Title="BookStore - Bejelentkezes"
        Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Border VerticalAlignment="Center" Margin="40">
            <StackPanel>
                <!-- Logo & Title -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="64" Height="64"
                                             Foreground="#FF5722" HorizontalAlignment="Center"/>
                    <TextBlock Text="AlkotasokTara" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="God Mode - Bejelentkezes" FontSize="14" Opacity="0.6"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Email -->
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Email cim"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16"
                         KeyDown="InputField_KeyDown"/>

                <!-- Password -->
                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Jelszo"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Margin="0,0,0,8"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             KeyDown="InputField_KeyDown"/>

                <!-- Error Message -->
                <Border Background="#33F44336" CornerRadius="4" Padding="12,8" Margin="0,8,0,8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44336"
                               TextWrapping="Wrap" FontSize="13"/>
                </Border>

                <!-- Login Button -->
                <Button Content="BEJELENTKEZES"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="4"
                        Background="#FF5722" Foreground="White"
                        Height="42" FontSize="14" FontWeight="Bold"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>

                <!-- Loading -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="32" Height="32"
                             Margin="0,16,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

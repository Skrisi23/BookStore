<UserControl x:Class="God.Support.mode.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:God.Support.mode.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <DockPanel Grid.Column="0">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                <TextBlock Text="Felhasznalok" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           VerticalAlignment="Center"/>
                <Button Content="{materialDesign:PackIcon Kind=Refresh}"
                        Command="{Binding LoadUsersCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        HorizontalAlignment="Right" ToolTip="Frissites"/>
            </DockPanel>

            <!-- Search Bar -->
            <materialDesign:Card DockPanel.Dock="Top" Margin="24,12,24,0" Padding="12">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Kereses nev vagy email szerint..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="4"/>
            </materialDesign:Card>

            <!-- DataGrid -->
            <DataGrid Margin="24,12,24,24"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserSortColumns="True"
                      AlternatingRowBackground="#1E1E1E"
                      materialDesign:DataGridAssist.CellPadding="12 8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Azon." Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Nev" Binding="{Binding Nev}" Width="*"/>
                    <DataGridTextColumn Header="Vezeteknev" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="Keresztnev" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Cim" Binding="{Binding DefaultAddress}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Detail Flyout Panel -->
        <Border Grid.Column="1" Width="380" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,12">
                    <TextBlock Text="Felhasznalo reszletei" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               VerticalAlignment="Center"/>
                    <Button Content="{materialDesign:PackIcon Kind=Close}"
                            Command="{Binding CloseDetailCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            HorizontalAlignment="Right"/>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
                    <StackPanel DataContext="{Binding}">
                        <!-- User Info -->
                        <TextBlock Text="{Binding SelectedUser.Nev}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedUser.Email}" Opacity="0.7" Margin="0,0,0,16"/>

                        <TextBlock Text="Azonosito:" Opacity="0.6"/>
                        <TextBlock Text="{Binding SelectedUser.Id}" Margin="0,4,0,12"/>
                        <TextBlock Text="Vezeteknev:" Opacity="0.6"/>
                        <TextBlock Text="{Binding SelectedUser.LastName}" Margin="0,4,0,12"/>
                        <TextBlock Text="Keresztnev:" Opacity="0.6"/>
                        <TextBlock Text="{Binding SelectedUser.FirstName}" Margin="0,4,0,12"/>
                        <TextBlock Text="Lakcim:" Opacity="0.6"/>
                        <TextBlock Text="{Binding SelectedUser.DefaultAddress}" TextWrapping="Wrap" Margin="0,4,0,16"/>

                        <Separator Margin="0,0,0,16"/>

                        <!-- Active Rentals -->
                        <TextBlock Text="Aktiv kolcsonzesek" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding UserRentals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2A2A2A" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold"/>
                                            <TextBlock Opacity="0.6" Margin="0,4,0,0">
                                                <Run Text="Hatarido:"/>
                                                <Run Text="{Binding LejaratDatum, StringFormat=yyyy-MM-dd, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,16"/>

                        <!-- Cart Contents -->
                        <TextBlock Text="Kosar tartalma" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding UserCartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2A2A2A" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock Text="{Binding BookCim}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} Ft'}"
                                                       HorizontalAlignment="Right" Opacity="0.7"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,16"/>

                        <!-- Payment History -->
                        <TextBlock Text="Fizetesi elozmenyek" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding UserPayments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2A2A2A" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0} Ft'}" FontWeight="SemiBold"/>
                                             <TextBlock Text="{Binding PaymentDate, StringFormat=yyyy-MM-dd}"
                                                       HorizontalAlignment="Right" Opacity="0.7"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,16"/>

                        <!-- Actions -->
                        <Button Content="Felhasznalo torlese" Command="{Binding DeleteUserCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#F44336" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2" Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              IsHitTestVisible="False">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

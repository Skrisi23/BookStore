<UserControl x:Class="God.Support.mode.Views.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:God.Support.mode.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
            <TextBlock Text="Orders / Payments" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                <Button Content="{materialDesign:PackIcon Kind=Refresh}"
                        Command="{Binding LoadPaymentsCommand}"
                        Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh"/>
            </StackPanel>
        </DockPanel>

        <!-- Filter Bar -->
        <materialDesign:Card DockPanel.Dock="Top" Margin="24,12,24,0" Padding="8">
            <StackPanel Orientation="Horizontal">
                <DatePicker SelectedDate="{Binding DateFrom}"
                            materialDesign:HintAssist.Hint="From Date"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Width="160" Margin="4"/>
                <DatePicker SelectedDate="{Binding DateTo}"
                            materialDesign:HintAssist.Hint="To Date"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Width="160" Margin="8,4,4,4"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search by user email..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Width="280" Margin="8,4,4,4"/>
            </StackPanel>
        </materialDesign:Card>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DataGrid -->
            <DataGrid Grid.Row="0" Margin="24,12"
                      ItemsSource="{Binding Payments}"
                      SelectedItem="{Binding SelectedPayment}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserSortColumns="True"
                      AlternatingRowBackground="#1E1E1E"
                      materialDesign:DataGridAssist.CellPadding="12 8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Payment ID" Binding="{Binding Id}" Width="90"/>
                    <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="User Email" Binding="{Binding UserEmail}" Width="*"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0} Ft'}" Width="110"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Items" Binding="{Binding Items.Count}" Width="70"/>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#2A2A2A" Padding="24,12" Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Purchased Items" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="{Binding BookTitle}" Width="250"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat='Qty: {0}'}" Width="80"/>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N0} Ft'}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="2" Background="#80000000"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                  IsHitTestVisible="False">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="48" Height="48"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="God.Support.mode.Views.CartsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:God.Support.mode.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:OrderTypeToColorConverter x:Key="OrderTypeToColor"/>
        <converters:OrderTypeToHungarianConverter x:Key="OrderTypeToHungarian"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                <TextBlock Text="Kosarak" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="Csak aktiv kosarak"
                              IsChecked="{Binding ShowOnlyActive}"
                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="{materialDesign:PackIcon Kind=Refresh}"
                            Command="{Binding LoadCartsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Frissites"/>
                </StackPanel>
            </DockPanel>

            <!-- DataGrid -->
            <DataGrid Margin="24,12,24,24"
                      ItemsSource="{Binding Carts}"
                      SelectedItem="{Binding SelectedCart}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserSortColumns="True"
                      AlternationCount="0"
                      materialDesign:DataGridAssist.CellPadding="12 8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kosar azon." Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Felhasznalo" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding UserEmail}" Width="*"/>
                    <DataGridTextColumn Header="Allapot" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Tetelek" Binding="{Binding TotalItems}" Width="70"/>
                    <DataGridTextColumn Header="Osszeg" Binding="{Binding TotalPrice, StringFormat='{}{0:N0} Ft'}" Width="110"/>
                    <DataGridTextColumn Header="Letrehozva" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Detail Panel -->
        <Border Grid.Column="1" Width="360" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                Visibility="{Binding SelectedCart, Converter={StaticResource NullToVis}}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,12">
                    <TextBlock Text="Kosar tartalma" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Button DockPanel.Dock="Bottom" Content="Kosar uritese" 
                        Command="{Binding ClearCartCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#F44336" Margin="16,8,16,16" HorizontalAlignment="Stretch"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding BookCim}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Border CornerRadius="3" Padding="5,2" HorizontalAlignment="Right"
                                                    Background="{Binding OrderType, Converter={StaticResource OrderTypeToColor}}">
                                                <TextBlock Text="{Binding OrderType, Converter={StaticResource OrderTypeToHungarian}}"
                                                           Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Opacity="0.7">
                                                <Run Text="Db: "/>
                                                <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold">
                                                <Run Text="{Binding Price, StringFormat='{}{0:N0} Ft', Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2" Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              IsHitTestVisible="False">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

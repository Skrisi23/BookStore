<UserControl x:Class="God.Support.mode.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:God.Support.mode.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                <TextBlock Text="Áttekintés" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           VerticalAlignment="Center"/>
                <Button Content="{materialDesign:PackIcon Kind=Refresh}" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        HorizontalAlignment="Right" ToolTip="Frissítés"/>
            </DockPanel>

            <!-- Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>
                    <!-- Summary Cards -->
                    <WrapPanel>
                        <materialDesign:Card Padding="20" Margin="0,0,16,16" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="Összes felhasználó" Opacity="0.6" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalUsers}" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Padding="20" Margin="0,0,16,16" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="Aktív kölcsönzések" Opacity="0.6" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ActiveRentals}" FontSize="32" FontWeight="Bold"
                                           Foreground="#4CAF50"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Padding="20" Margin="0,0,16,16" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="Lejárt kölcsönzések" Opacity="0.6" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding OverdueRentals}" FontSize="32" FontWeight="Bold"
                                           Foreground="#F44336"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Padding="20" Margin="0,0,16,16" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="Összes könyv" Opacity="0.6" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalBooks}" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Padding="20" Margin="0,0,16,16" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="Összes bevétel" Opacity="0.6" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} Ft'}" 
                                           FontSize="32" FontWeight="Bold" Foreground="#FF9800"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Padding="20" Margin="0,0,16,16" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="Összes rendelés" Opacity="0.6" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalOrders}" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </WrapPanel>

                    <!-- Chart -->
                    <materialDesign:Card Padding="16" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Kölcsönzések naponta (utolsó 30 nap)" 
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,8"/>
                            <ContentControl x:Name="ChartHost" Height="300"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Loading Overlay -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              IsHitTestVisible="False">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="God.Support.mode.Views.CartsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:God.Support.mode.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                <TextBlock Text="Kosarak" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           VerticalAlignment="Center"/>
                <Button Content="{materialDesign:PackIcon Kind=Refresh}"
                        Command="{Binding LoadCartsCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        HorizontalAlignment="Right" ToolTip="Frissítés"/>
            </DockPanel>

            <!-- DataGrid -->
            <DataGrid Margin="24,12,24,24"
                      ItemsSource="{Binding Carts}"
                      SelectedItem="{Binding SelectedCart}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserSortColumns="True"
                      AlternatingRowBackground="#1E1E1E"
                      materialDesign:DataGridAssist.CellPadding="12 8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kosár azon." Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Felhasználó" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding UserEmail}" Width="*"/>
                    <DataGridTextColumn Header="Tételek száma" Binding="{Binding Items.Count}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Detail Panel -->
        <Border Grid.Column="1" Width="360" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                Visibility="{Binding SelectedCart, Converter={StaticResource NullToVis}}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,12">
                    <TextBlock Text="Kosár tartalma" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Button DockPanel.Dock="Bottom" Content="Kosár ürítése" 
                        Command="{Binding ClearCartCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#F44336" Margin="16,8,16,16" HorizontalAlignment="Stretch"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BookCim}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Opacity="0.7">
                                                <Run Text="Db: "/>
                                                <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock HorizontalAlignment="Right" Opacity="0.7">
                                                <Run Text="Egységár: "/>
                                                <Run Text="{Binding Price, StringFormat='{}{0:N0} Ft', Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Margin="0,6,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:N0} Ft">
                                                    <Binding Path="Price"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2" Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              IsHitTestVisible="False">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

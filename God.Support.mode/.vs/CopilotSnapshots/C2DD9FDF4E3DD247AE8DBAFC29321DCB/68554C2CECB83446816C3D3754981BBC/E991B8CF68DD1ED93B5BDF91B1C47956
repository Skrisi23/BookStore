<UserControl x:Class="God.Support.mode.Views.RentalsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:God.Support.mode.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrush"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
            <TextBlock Text="Kölcsönzések" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       VerticalAlignment="Center"/>
            <Button Content="{materialDesign:PackIcon Kind=Refresh}"
                    Command="{Binding LoadRentalsCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    HorizontalAlignment="Right" ToolTip="Frissítés"/>
        </DockPanel>

        <!-- Filter Bar -->
        <materialDesign:Card DockPanel.Dock="Top" Margin="24,12,24,0" Padding="12">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          materialDesign:HintAssist.Hint="Állapot"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="160" Margin="4"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Keresés felhasználó vagy könyv szerint..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Width="300" Margin="12,4,4,4"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Summary Bar -->
        <materialDesign:Card DockPanel.Dock="Bottom" Margin="24,0,24,16" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                    <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Aktív: "/>
                        <Run Text="{Binding TotalActive, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                    <Ellipse Width="12" Height="12" Fill="#F44336" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Lejárt: "/>
                        <Run Text="{Binding TotalOverdue, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="#9E9E9E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Visszahozva: "/>
                        <Run Text="{Binding TotalReturned, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- DataGrid -->
        <Grid>
            <DataGrid Margin="24,12"
                      ItemsSource="{Binding Rentals}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserSortColumns="True"
                      AlternatingRowBackground="#1E1E1E"
                      materialDesign:DataGridAssist.CellPadding="12 8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Azon." Binding="{Binding Rental.Id}" Width="60"/>
                    <DataGridTextColumn Header="Könyv címe" Binding="{Binding Rental.BookTitle}" Width="*"/>
                    <DataGridTextColumn Header="Felhasználó" Binding="{Binding Rental.UserName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Rental.UserEmail}" Width="*"/>
                    <DataGridTextColumn Header="Kölcsönzés" Binding="{Binding Rental.KolcsonzesDatuma, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="Határidő" Binding="{Binding Rental.LejaratDatum, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="Visszahozva" Binding="{Binding Rental.VisszahozvaDatuma, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTemplateColumn Header="Állapot" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                        CornerRadius="10" Padding="10,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Napok" Binding="{Binding DaysInfo}" Width="130"/>
                    <DataGridTemplateColumn Header="Műveletek" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Visszavétel" 
                                            Command="{Binding DataContext.MarkReturnedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Padding="8,2" Margin="0,0,8,0" FontSize="11"/>
                                    <Button Content="Emlékeztető"
                                            Command="{Binding DataContext.SendReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Padding="8,2" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading Overlay -->
            <Grid Background="#80000000"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                  IsHitTestVisible="False">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="48" Height="48"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

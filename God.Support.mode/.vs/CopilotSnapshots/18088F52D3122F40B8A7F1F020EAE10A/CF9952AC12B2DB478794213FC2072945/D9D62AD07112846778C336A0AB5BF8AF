<Window x:Class="God.Support.mode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:God.Support.mode.Converters"
        mc:Ignorable="d"
        Title="BookStore God Mode"
        MinHeight="800" MinWidth="1280"
        Height="800" Width="1280"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <materialDesign:DialogHost>
        <materialDesign:DialogHost.Resources>
            <converters:ResourceKeyToStringConverter x:Key="ResKeyConv"/>
        </materialDesign:DialogHost.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#1a1a1a">
                <DockPanel>
                    <!-- App Title -->
                    <Border DockPanel.Dock="Top" Padding="20,24,20,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="32" Height="32"
                                                         Foreground="#FF5722" VerticalAlignment="Center"/>
                                <TextBlock Text="AlkotásokTára" FontSize="20" FontWeight="Bold" 
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="God Mode" FontSize="12" Opacity="0.5" Margin="42,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Separator DockPanel.Dock="Top" Background="#333"/>

                    <!-- Language Toggle at bottom -->
                    <Border DockPanel.Dock="Bottom" Padding="16,8,16,16">
                        <Button Command="{Binding ToggleLanguageCommand}"
                                Content="{DynamicResource Lang_Toggle}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Stretch"
                                FontSize="13" Padding="8,6"
                                BorderBrush="#444" Foreground="#AAA"/>
                    </Border>

                    <Separator DockPanel.Dock="Bottom" Background="#333"/>

                    <!-- Navigation -->
                    <ListBox ItemsSource="{Binding NavKeys}"
                             SelectedIndex="{Binding SelectedNavIndex}"
                             Margin="0,8,0,0"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="20,12"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="ViewDashboard"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="Nav_Users">
                                                        <Setter Property="Kind" Value="AccountGroup"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Nav_Books">
                                                        <Setter Property="Kind" Value="BookMultiple"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Nav_Rentals">
                                                        <Setter Property="Kind" Value="SwapHorizontal"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Nav_Orders">
                                                        <Setter Property="Kind" Value="CreditCard"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Nav_Carts">
                                                        <Setter Property="Kind" Value="Cart"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Nav_Settings">
                                                        <Setter Property="Kind" Value="Cog"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{DynamicResource {Binding}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentViewModel}" Margin="0"/>

                <!-- Snackbar -->
                <materialDesign:Snackbar MessageQueue="{Binding MessageQueue}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,12"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
